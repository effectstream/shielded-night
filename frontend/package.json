  "//overrides": [
    "The ledger-v9 line. Same single-wasm-copy rule as the root package.json:",
    "@midnightntwrk/ledger-v9 (NOTE the scope has no hyphen) replaces",
    "@midnight-ntwrk/ledger-v8, and compact-runtime is forced to 0.19.0 because",
    "midnight-js 5.0.0-beta.7 pins the byte-identical 0.19.0-rc.0 while compactc",
    "0.34.0 emits checkRuntimeVersion('0.19.0'). onchain-runtime-v4 is pinned one",
    "level down for the same reason. These MUST agree with resolve.dedupe in",
    "vite.config.ts, which collapses the copies the ROOT node_modules would",
    "otherwise contribute through ../src/managed."
  ]
